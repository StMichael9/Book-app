# Local development only. Never commit real credentials.
DATABASE_URL=postgresql://bookvane_dev:replace-me@localhost:5432/bookvane_dev
SECRET_KEY=replace-with-a-random-value-at-least-32-bytes-long
IS_DEV=true
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
# Verify shelfbound.dev and set these to enable password recovery.
RESEND_API_KEY=
PASSWORD_RESET_FROM="Bookvane <reset@shelfbound.dev>"
# V3 development/pilot only. Keep off in production until approved.
READING_V3_ENABLED=false
# Optional comma-separated account UUIDs; empty enables all only when the flag is true.
READING_V3_USER_IDS=
# M5 stays separately disabled until native-export acceptance and QA approval.
# May lower this ceiling, never raise a saved catalogue import storage guard.
LIBRARY_IMPORT_MAX_DATABASE_MB=800
